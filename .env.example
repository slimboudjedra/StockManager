# Diese Datei nach ".env" kopieren und die Werte anpassen.
# Die Datei ".env" wird NICHT in Git gespeichert.
#
# Die Werte unten sind öffentlich bekannte Demo-Werte für die lokale Demo-Umgebung.
# Verwenden Sie sie nie für eine Installation, die von außen erreichbar ist,
# und nie als Passwort für etwas anderes.

# Passwort des SQL-Server-Administrators "sa":
# mindestens 8 Zeichen mit Groß- und Kleinbuchstaben, Ziffer und Sonderzeichen.
# Bitte kein Semikolon, keine Anführungszeichen und kein Dollarzeichen verwenden.
SQL_SA_PASSWORD=Demo-Sql-Passwort-2026!

# Demo-Konto der Anwendung (das Passwort braucht mindestens 10 Zeichen
# mit Groß- und Kleinbuchstaben, Ziffer und Sonderzeichen):
ADMIN_EMAIL=demo@stockmanager.example
ADMIN_PASSWORD=Demo-Lager-2026!

# Demodaten beim ersten Start anlegen (true oder false):
SEED_DEMO_DATA=true