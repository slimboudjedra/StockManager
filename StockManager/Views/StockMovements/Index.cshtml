@using System.Globalization
@using StockManager.Models
@using StockManager.ViewModels
@model StockMovementHistoryViewModel

@{
    Layout = "_PageLayout";
    ViewData["Title"] = "Bestandshistorie";
    ViewData["Subtitle"] = Model.ProductName + " (" + Model.ProductReference + ")";

    var de = CultureInfo.GetCultureInfo("de-DE");
}

@section PageActions {
    <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-outline-secondary">Zum Produkt</a>
    <a asp-action="Create" asp-route-productId="@Model.ProductId" class="btn btn-primary">
        <i data-lucide="plus" class="me-1"></i>Bestand buchen
    </a>
}

<div class="stat-strip mb-4">
    <div class="stat">
        <div class="stat__label">Aktueller Bestand</div>
        <div class="stat__value">@Model.CurrentQuantity</div>
    </div>
    <div class="stat">
        <div class="stat__label">Bewegungen</div>
        <div class="stat__value">@Model.TotalMovements</div>
    </div>
</div>

<div class="panel">
    @if (!Model.Movements.Any())
    {
        <partial name="_EmptyState"
                 model='new EmptyStateModel("clipboard-list", "Noch keine Bewegungen", "Für dieses Produkt wurden noch keine Bewegungen gebucht.")' />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Datum</th>
                        <th>Art</th>
                        <th class="text-end">Änderung</th>
                        <th class="text-end">Bestand danach</th>
                        <th>Kommentar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var movement in Model.Movements)
                    {
                        <tr>
                            <td class="text-secondary">@movement.CreatedAt.ToLocalTime().ToString("g", de)</td>
                            <td>@movement.MovementType.GetDisplayName()</td>
                            <td class="text-end fw-medium @(movement.QuantityChange > 0 ? "text-success" : "text-danger")">
                                @(movement.QuantityChange > 0 ? "+" : "")@movement.QuantityChange
                            </td>
                            <td class="text-end">@movement.QuantityAfter</td>
                            <td class="text-secondary">@movement.Comment</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Seitennavigation">
        <ul class="pagination pagination-sm justify-content-center mb-0">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-productId="@Model.ProductId" asp-route-page="@(Model.CurrentPage - 1)">Zurück</a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-productId="@Model.ProductId" asp-route-page="@i">@i</a>
                </li>
            }

            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-productId="@Model.ProductId" asp-route-page="@(Model.CurrentPage + 1)">Nächste</a>
            </li>
        </ul>
    </nav>
}