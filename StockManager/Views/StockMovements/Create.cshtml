@using StockManager.Models
@model StockManager.ViewModels.StockMovementCreateViewModel

@{
    Layout = "_PageLayout";
    ViewData["Title"] = "Bestand buchen";
    ViewData["Subtitle"] = Model.ProductName + " (" + Model.ProductReference + ")";
}

<a asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId" class="back-link"><i data-lucide="arrow-left"></i>Zurück zum Produkt</a>

<div class="stat-strip mb-4">
    <div class="stat">
        <div class="stat__label">Aktueller Bestand</div>
        <div class="stat__value">@Model.CurrentQuantity</div>
    </div>
    <div class="stat">
        <div class="stat__label">Mindestbestand</div>
        <div class="stat__value">@Model.MinimumStock</div>
    </div>
</div>

<form asp-action="Create" method="post" data-submit-once class="panel form-panel">
    <div class="panel-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="ProductId" />

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="MovementType" class="form-label"></label>
                <select asp-for="MovementType"
                        asp-items="Html.GetEnumSelectList<StockMovementType>()"
                        class="form-select"></select>
                <span asp-validation-for="MovementType" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <div id="quantityHint" class="field-hint"></div>
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Comment" class="form-label"></label>
                <textarea asp-for="Comment" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Comment" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Buchen</button>
            <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-outline-secondary">Abbrechen</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_SubmitOnce" />

    <script>
        (function () {
            var typeSelect = document.getElementById("MovementType");
            var hint = document.getElementById("quantityHint");
            var hints = {
                "1": "Anzahl der Einheiten, die ins Lager kommen.",
                "2": "Anzahl der Einheiten, die das Lager verlassen.",
                "3": "Gezählter Bestand (nicht die Differenz)."
            };

            function updateHint() {
                hint.textContent = hints[typeSelect.value] || "";
            }

            typeSelect.addEventListener("change", updateHint);
            updateHint();
        })();
    </script>
}