@using StockManager.Models
@model StockManager.ViewModels.StockMovementCreateViewModel

@{
    ViewData["Title"] = "Bestand buchen";
}

<h1>Bestand buchen</h1>

<h4>
    @Model.ProductName
    <small class="text-muted">(@Model.ProductReference)</small>
</h4>
<p>
    Aktueller Bestand: <strong>@Model.CurrentQuantity</strong>
    &middot; Mindestbestand: @Model.MinimumStock
</p>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post" id="movementForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ProductId" />

            <div class="mb-3">
                <label asp-for="MovementType" class="form-label"></label>
                <select asp-for="MovementType"
                        asp-items="Html.GetEnumSelectList<StockMovementType>()"
                        class="form-select"></select>
                <span asp-validation-for="MovementType" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <div id="quantityHint" class="form-text"></div>
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Comment" class="form-label"></label>
                <textarea asp-for="Comment" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Comment" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary" id="submitButton">Buchen</button>
            <a asp-controller="Products" asp-action="Index" class="btn btn-secondary">Abbrechen</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const typeSelect = document.getElementById('MovementType');
        const hint = document.getElementById('quantityHint');
        const form = document.getElementById('movementForm');
        const button = document.getElementById('submitButton');

        const hints = {
            '1': 'Anzahl der Einheiten, die ins Lager kommen.',
            '2': 'Anzahl der Einheiten, die das Lager verlassen.',
            '3': 'Gezählter Bestand (nicht die Differenz).'
        };

        function updateHint() {
            hint.textContent = hints[typeSelect.value] ?? '';
        }

        typeSelect.addEventListener('change', updateHint);
        updateHint();

        // Verhindert doppelte Buchungen bei Doppelklick
        form.addEventListener('submit', function () {
            if (window.jQuery && !window.jQuery(form).valid()) {
                return;
            }
            button.disabled = true;
            button.textContent = 'Wird gespeichert...';
        });
    </script>
}