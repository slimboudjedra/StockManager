@model StockManager.Models.Category

@{
    Layout = "_PageLayout";
    ViewData["Title"] = "Kategorie löschen";
    ViewData["Subtitle"] = Model.Name;
}

<a asp-action="Details" asp-route-id="@Model.Id" class="back-link"><i data-lucide="arrow-left"></i>Zurück zur Kategorie</a>

<section class="panel form-panel">
    <div class="panel-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <p class="fw-medium">Möchten Sie diese Kategorie wirklich löschen?</p>
        <p class="text-secondary mb-0">
            Eine Kategorie, der noch Produkte zugeordnet sind (auch archivierte), kann nicht gelöscht werden.
        </p>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="form-actions">
                <button type="submit" class="btn btn-danger">Löschen</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Abbrechen</a>
            </div>
        </form>
    </div>
</section>