@using StockManager.ViewModels
@model IEnumerable<StockManager.Models.Category>

@{
    Layout = "_PageLayout";
    ViewData["Title"] = "Kategorien";
    ViewData["Subtitle"] = "Produkte nach Kategorien ordnen.";
}

@section PageActions {
    <a asp-action="Create" class="btn btn-primary">
        <i data-lucide="plus" class="me-1"></i>Neue Kategorie
    </a>
}

<div class="panel">
    @if (!Model.Any())
    {
        <partial name="_EmptyState"
                 model='new EmptyStateModel("tags", "Noch keine Kategorien", "Legen Sie mit „Neue Kategorie“ die erste Kategorie an.")' />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Beschreibung</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td class="fw-medium">@category.Name</td>
                            <td class="text-secondary">@category.Description</td>
                            <td class="text-end text-nowrap">
                                <span class="row-links">
                                    <a asp-action="Details" asp-route-id="@category.Id">Details</a>
                                    <a asp-action="Edit" asp-route-id="@category.Id">Bearbeiten</a>
                                    <a asp-action="Delete" asp-route-id="@category.Id" class="row-links__danger">Löschen</a>
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>