@model IEnumerable<StockManager.Models.Category>

@{
    ViewData["Title"] = "Kategorien";
}

<h1>Kategorien</h1>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success">
        @message
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">
        Neue Kategorie
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Beschreibung</th>
            <th>Aktionen</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>@category.Description</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary">
                        Bearbeiten
                    </a>
                    <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger">
                        Löschen
                    </a>
                    <a asp-action="Details" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary">
                        Details
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
