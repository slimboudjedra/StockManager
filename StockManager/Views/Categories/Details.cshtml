@model StockManager.ViewModels.CategoryDetailsViewModel

@{
    ViewData["Title"] = "Kategorie: " + Model.Name;
}

<h1>@Model.Name</h1>

<dl class="row">
    <dt class="col-sm-3">Beschreibung</dt>
    <dd class="col-sm-9">
        @(string.IsNullOrWhiteSpace(Model.Description) ? "–" : Model.Description)
    </dd>

    <dt class="col-sm-3">Aktive Produkte</dt>
    <dd class="col-sm-9">@Model.ActiveProductCount</dd>

    <dt class="col-sm-3">Archivierte Produkte</dt>
    <dd class="col-sm-9">@Model.ArchivedProductCount</dd>
</dl>

@if (Model.ArchivedProductCount > 0)
{
    <div class="alert alert-info" role="status">
        Archivierte Produkte gehören weiterhin zu dieser Kategorie.
        Solange es sie gibt, kann die Kategorie nicht gelöscht werden.
    </div>
}

<h2 class="h4">Produkte in dieser Kategorie</h2>

@if (!Model.Products.Any())
{
    <p class="text-muted">Dieser Kategorie sind keine aktiven Produkte zugeordnet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Referenz</th>
                <th>Produktname</th>
                <th>Bestand</th>
                <th>Mindestbestand</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>@product.Reference</td>
                    <td>@product.Name</td>
                    <td>@product.Quantity</td>
                    <td>@product.MinimumStock</td>
                    <td>
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">
                            Details
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Bearbeiten</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Löschen</a>
    <a asp-action="Index" class="btn btn-secondary">Zurück zur Liste</a>
</div>