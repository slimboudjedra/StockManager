@using StockManager.ViewModels
@model CategoryDetailsViewModel

@{
    Layout = "_PageLayout";
    ViewData["Title"] = Model.Name;
    ViewData["Subtitle"] = string.IsNullOrWhiteSpace(Model.Description) ? "Kategorie" : Model.Description;
}

@section PageActions {
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Bearbeiten</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Löschen</a>
}

<a asp-action="Index" class="back-link"><i data-lucide="arrow-left"></i>Alle Kategorien</a>

<div class="stat-strip mb-4">
    <div class="stat">
        <div class="stat__label">Aktive Produkte</div>
        <div class="stat__value">@Model.ActiveProductCount</div>
    </div>
    <div class="stat">
        <div class="stat__label">Archivierte Produkte</div>
        <div class="stat__value">@Model.ArchivedProductCount</div>
    </div>
</div>

@if (Model.ArchivedProductCount > 0)
{
    <div class="alert alert-info" role="status">
        Archivierte Produkte gehören weiterhin zu dieser Kategorie. Solange es sie gibt,
        kann die Kategorie nicht gelöscht werden.
    </div>
}

<section class="panel">
    <div class="panel-header">
        <h2 class="panel-title">Produkte in dieser Kategorie</h2>
    </div>

    @if (!Model.Products.Any())
    {
        <partial name="_EmptyState"
                 model='new EmptyStateModel("boxes", "Keine aktiven Produkte", "Dieser Kategorie sind keine aktiven Produkte zugeordnet.")' />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Referenz</th>
                        <th>Produkt</th>
                        <th>Bestand</th>
                        <th class="text-end">Mindestbestand</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td class="text-secondary">@product.Reference</td>
                            <td class="fw-medium">@product.Name</td>
                            <td>
                                <partial name="_StockLevel" model="new StockLevelModel(product.Quantity, product.MinimumStock)" />
                            </td>
                            <td class="text-end">@product.MinimumStock</td>
                            <td class="text-end">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>