@using System.Globalization
@using StockManager.Models
@using StockManager.ViewModels
@model DashboardViewModel

@{
    Layout = "_PageLayout";
    ViewData["Title"] = "Übersicht";
    ViewData["Subtitle"] = "Bestände und Aktivitäten auf einen Blick.";

    var de = CultureInfo.GetCultureInfo("de-DE");
}

@section PageActions {
    <a asp-controller="Reorder" asp-action="Index" class="btn btn-outline-secondary">
        <i data-lucide="shopping-cart" class="me-1"></i>Nachbestellvorschlag
    </a>
    <a asp-controller="Products" asp-action="Create" class="btn btn-primary">
        <i data-lucide="plus" class="me-1"></i>Neuer Artikel
    </a>
}

<div class="stat-strip mb-4">

    <div class="stat">
        <div class="stat__label">Aktive Produkte</div>
        <div class="stat__value">@Model.ActiveProductCount</div>
        <a class="stat__link" asp-controller="Products" asp-action="Index">Alle anzeigen</a>
    </div>

    <div class="stat">
        <div class="stat__label">Kategorien</div>
        <div class="stat__value">@Model.CategoryCount</div>
        <a class="stat__link" asp-controller="Categories" asp-action="Index">Alle anzeigen</a>
    </div>

    <div class="stat">
        <div class="stat__label">Lagerwert</div>
        <div class="stat__value">@Model.TotalStockValue.ToString("N2", de) €</div>
        <span class="stat__hint">Bestand × Einzelpreis</span>
    </div>

    <div class="stat @(Model.LowStockCount > 0 ? "stat--alert" : "")">
        <div class="stat__label">Unter Mindestbestand</div>
        <div class="stat__value">@Model.LowStockCount</div>
        <a class="stat__link" asp-controller="Products" asp-action="Index" asp-route-lowStockOnly="true">Bestände prüfen</a>
    </div>

</div>

<section class="panel mb-4">
    <div class="panel-header">
        <h2 class="panel-title">Unter Mindestbestand</h2>

        @if (Model.LowStockCount > Model.LowStockProducts.Count)
        {
            <a class="small" asp-controller="Products" asp-action="Index" asp-route-lowStockOnly="true">
                Alle @Model.LowStockCount anzeigen
            </a>
        }
    </div>

    @if (!Model.LowStockProducts.Any())
    {
        <partial name="_EmptyState"
                 model='new EmptyStateModel("check-circle", "Alles in Ordnung", "Alle Produkte haben einen ausreichenden Lagerbestand.")' />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Referenz</th>
                        <th>Produkt</th>
                        <th>Bestand</th>
                        <th class="text-end">Mindestbestand</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.LowStockProducts)
                    {
                        <tr>
                            <td class="text-secondary">@product.Reference</td>
                            <td class="fw-medium">@product.Name</td>
                            <td>
                                <partial name="_StockLevel" model="new StockLevelModel(product.Quantity, product.MinimumStock)" />
                            </td>
                            <td class="text-end">@product.MinimumStock</td>
                            <td class="text-end">
                                <a asp-controller="StockMovements" asp-action="Create" asp-route-productId="@product.Id"
                                   class="btn btn-sm btn-outline-primary">Bestand buchen</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel">
    <div class="panel-header">
        <h2 class="panel-title">Letzte Lagerbewegungen</h2>
    </div>

    @if (!Model.RecentMovements.Any())
    {
        <partial name="_EmptyState"
                 model='new EmptyStateModel("clipboard-list", "Noch keine Bewegungen", "Es wurden noch keine Lagerbewegungen gebucht.")' />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Datum</th>
                        <th>Produkt</th>
                        <th>Art</th>
                        <th class="text-end">Änderung</th>
                        <th class="text-end">Bestand danach</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var movement in Model.RecentMovements)
                    {
                        <tr>
                            <td class="text-secondary small">@movement.CreatedAt.ToLocalTime().ToString("g", de)</td>
                            <td>
                                <a class="fw-medium text-decoration-none"
                                   asp-controller="StockMovements" asp-action="Index"
                                   asp-route-productId="@movement.ProductId">@movement.ProductName</a>
                                <div class="text-secondary small">@movement.ProductReference</div>
                            </td>
                            <td>@movement.MovementType.GetDisplayName()</td>
                            <td class="text-end fw-medium @(movement.QuantityChange > 0 ? "text-success" : "text-danger")">
                                @(movement.QuantityChange > 0 ? "+" : "")@movement.QuantityChange
                            </td>
                            <td class="text-end">@movement.QuantityAfter</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>