@model StockManager.Models.Product

@{
    Layout = "_PageLayout";
    ViewData["Title"] = "Produkt archivieren";
    ViewData["Subtitle"] = Model.Name + " (" + Model.Reference + ")";
}

<a asp-action="Details" asp-route-id="@Model.Id" class="back-link"><i data-lucide="arrow-left"></i>Zurück zum Produkt</a>

<section class="panel form-panel">
    <div class="panel-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <p class="fw-medium">Möchten Sie dieses Produkt wirklich archivieren?</p>
        <p class="text-secondary mb-0">
            Das Produkt wird nicht gelöscht, sondern erscheint nicht mehr in den Listen.
            Ein Produkt, das noch in einer offenen Bestellung steht, kann nicht archiviert werden.
        </p>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="form-actions">
                <button type="submit" class="btn btn-danger">Archivieren</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Abbrechen</a>
            </div>
        </form>
    </div>
</section>