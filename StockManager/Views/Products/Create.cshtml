@model StockManager.ViewModels.ProductEditViewModel

@{
    Layout = "_PageLayout";
    ViewData["Title"] = "Neuer Artikel";
    ViewData["Subtitle"] = "Der Bestand startet bei 0 und wird über Wareneingänge gebucht.";
}

<a asp-action="Index" class="back-link"><i data-lucide="arrow-left"></i>Alle Produkte</a>

<form asp-action="Create" method="post" data-submit-once class="panel form-panel">
    <div class="panel-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <partial name="_ProductFormFields" model="Model" />

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Artikel erstellen</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Abbrechen</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_SubmitOnce" />
}