@model StockManager.ViewModels.ProductEditViewModel

@{
    ViewData["Title"] = "Produkt erstellen";
}

<div class="container py-4">

    <!-- Seitenkopf -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="text-primary fw-semibold small text-uppercase">
                PRODUKTVERWALTUNG
            </span>
            <h1 class="h2 fw-bold mt-2 mb-1">Neues Produkt erstellen</h1>
            <p class="text-secondary mb-0">
                Erfassen Sie ein neues Produkt für Ihre Lagerverwaltung.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i data-lucide="arrow-left" class="me-1"></i>
            Zurück zur Übersicht
        </a>
    </div>

    <!-- Formular-Karte -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center gap-3">
                <span class="text-primary">
                    <i data-lucide="package-plus"></i>
                </span>
                <div>
                    <h2 class="h5 fw-bold mb-1">Produktinformationen</h2>
                    <p class="text-secondary small mb-0">
                        Füllen Sie die folgenden Angaben aus.
                    </p>
                </div>
            </div>
        </div>

        <div class="card-body p-4">

            <form asp-action="Create" method="post" id="createProductForm">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert">
                </div>

                <div class="row g-3">

                    <!-- Artikelnummer -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Reference" class="form-label fw-semibold">
                            Artikelnummer
                        </label>

                        <input asp-for="Reference"
                               class="form-control"
                               placeholder="z. B. ART-001" />

                        <span asp-validation-for="Reference"
                              class="text-danger small">
                        </span>
                    </div>

                    <!-- Produktname -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Name" class="form-label fw-semibold">
                            Produktname
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Produktnamen eingeben" />

                        <span asp-validation-for="Name"
                              class="text-danger small">
                        </span>
                    </div>

                    <!-- Kategorie -->
                    <div class="col-12 col-md-6">
                        <label asp-for="CategoryId" class="form-label fw-semibold">
                            Kategorie
                        </label>

                        <select asp-for="CategoryId"
                                asp-items="Model.Categories"
                                class="form-select">
                            <option value="0">Kategorie auswählen</option>
                        </select>

                        <span asp-validation-for="CategoryId"
                              class="text-danger small">
                        </span>
                    </div>

                    <!-- Mindestbestand -->
                    <div class="col-12 col-md-6">
                        <label asp-for="MinimumStock" class="form-label fw-semibold">
                            Mindestbestand
                        </label>

                        <input asp-for="MinimumStock"
                               class="form-control"
                               type="number"
                               placeholder="0" />

                        <span asp-validation-for="MinimumStock"
                              class="text-danger small">
                        </span>

                        <div class="form-text">
                            Unter diesem Wert wird eine Lagerwarnung angezeigt.
                        </div>
                    </div>

                    <!-- Stückpreis -->
                    <div class="col-12 col-md-6">
                        <label asp-for="UnitPrice" class="form-label fw-semibold">
                            Stückpreis
                        </label>

                        <div class="input-group">
                            <input asp-for="UnitPrice"
                                   class="form-control"
                                   placeholder="0,00" />
                            <span class="input-group-text">€</span>
                        </div>

                        <span asp-validation-for="UnitPrice"
                              class="text-danger small">
                        </span>
                    </div>

                    <!-- Beschreibung -->
                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold">
                            Beschreibung
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Produktbeschreibung eingeben..."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger small">
                        </span>
                    </div>

                </div>

                <!-- Formularaktionen -->
                <div class="d-flex justify-content-end flex-wrap gap-2 border-top pt-4 mt-4">

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Abbrechen
                    </a>

                    <button type="submit"
                            class="btn btn-primary"
                            id="createButton">
                        <i data-lucide="plus-circle" class="me-1"></i>
                        Produkt erstellen
                    </button>

                </div>

            </form>
        </div>
    </div>

    <!-- Information -->
    <div class="alert alert-info d-flex align-items-center gap-2 mt-3 mb-0">
        <i data-lucide="info"></i>
        <span>Bitte überprüfen Sie Ihre Angaben vor dem Speichern.</span>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const form = document.getElementById("createProductForm");
            const button = document.getElementById("createButton");

            if (!form || !button) {
                return;
            }

            form.addEventListener("submit", function (event) {

                if (!form.checkValidity()) {
                    return;
                }

                if (button.disabled) {
                    event.preventDefault();
                    return;
                }

                button.disabled = true;
                button.innerHTML = `
                    <span class="spinner-border spinner-border-sm me-2"
                          aria-hidden="true"></span>
                    Wird gespeichert...
                `;
            });
        });
    </script>
}