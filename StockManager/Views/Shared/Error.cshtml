 @model ErrorViewModel
@{
    ViewData["Title"] = "Fehler";
}

<div class="container py-5 text-center">
    <h1 class="text-danger mb-3">Ein Fehler ist aufgetreten.</h1>

    <p class="lead">
        Bei der Verarbeitung deiner Anfrage ist ein unerwarteter Fehler aufgetreten.
    </p>

    <p>
        Bitte versuche es später erneut. Falls das Problem weiterhin besteht,
        wende dich an den Administrator.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted mt-4">
            <strong>Anfrage-ID:</strong>
            <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-primary mt-3">
        Zur Startseite
    </a>
</div>