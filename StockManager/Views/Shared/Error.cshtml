@model StockManager.Models.ErrorViewModel

@{
    ViewData["Title"] = "Fehler";
}

<section class="panel form-panel">
    <div class="panel-body">
        <h1 class="h4 mb-2">Es ist ein Fehler aufgetreten</h1>
        <p class="text-secondary">
            Bei der Verarbeitung Ihrer Anfrage ist ein Problem aufgetreten. Bitte versuchen Sie es erneut.
        </p>

        @if (Model.ShowRequestId)
        {
            <p class="text-secondary small">Anfrage-ID: <code>@Model.RequestId</code></p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Zur Startseite</a>
    </div>
</section>