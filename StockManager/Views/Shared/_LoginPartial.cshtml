@if (User.Identity?.IsAuthenticated == true)
{
    <div class="app-user__name" title="@User.Identity.Name">@User.Identity.Name</div>

    <form asp-controller="Account" asp-action="Logout" method="post">
        <button type="submit" class="app-user__button">
            <i data-lucide="log-out"></i>
            <span>Abmelden</span>
        </button>
    </form>
}