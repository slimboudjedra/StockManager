<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - StockManager</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StockManager.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg sm-navbar">
            <div class="container-fluid px-4">

                <a class="navbar-brand sm-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    <i data-lucide="package" class="brand-icon"></i>
                    <span>StockManager</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Menü anzeigen">

                    <i data-lucide="menu"></i>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav me-auto ms-lg-4">

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                               asp-controller="Home"
                               asp-action="Index">
                                <i data-lucide="layout-dashboard"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Privacy" ? "active" : "")"
                               asp-controller="Home"
                               asp-action="Privacy">
                                <i data-lucide="shield-check"></i>
                                <span>Datenschutz</span>
                            </a>
                        </li>

                    </ul>

                    <div class="navbar-user">
                        <partial name="_LoginPartial" />
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <div class="sm-page-container">
        <main role="main" class="sm-main-content">
            @RenderBody()
        </main>
    </div>

    <footer class="sm-footer">
        <div class="container-fluid px-4">
            <span>&copy; @DateTime.Now.Year StockManager</span>

            <a asp-controller="Home" asp-action="Privacy">
                Datenschutz
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="https://unpkg.com/lucide@latest"></script>

    <script>
            document.addEventListener("DOMContentLoaded", function () {
                if (window.lucide) {
                    lucide.createIcons();
                }
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
